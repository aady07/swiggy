# =============================================================================
# Swiggy — nginx site config
# =============================================================================
# 1. DNS: A record swiggy.thetarunainitiative.in -> EC2 public IP
# 2. Security group: allow 80, 443 inbound
# 3. SSL (once, Let's Encrypt — run BEFORE enabling this file if no cert yet):
#      sudo systemctl stop nginx
#      sudo certbot certonly --standalone -d swiggy.thetarunainitiative.in
#      sudo systemctl start nginx
# 4. Install: sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/swiggy.conf
# 5. Test:   sudo nginx -t
# 6. Reload: sudo systemctl reload nginx
# 7. Deploy: cd /home/ec2-user/swiggy && ./deploy/deploy.sh main
# =============================================================================

server {
    listen 443 ssl;
    server_name swiggy.thetarunainitiative.in;

    ssl_certificate     /etc/letsencrypt/live/swiggy.thetarunainitiative.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/swiggy.thetarunainitiative.in/privkey.pem;

    client_max_body_size 4m;

    location /ws {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    server_name swiggy.thetarunainitiative.in;
    return 301 https://$host$request_uri;
}
