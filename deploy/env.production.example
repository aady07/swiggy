# Copy to /home/ec2-user/swiggy/.env on EC2 and fill in secrets.
# cp deploy/env.production.example .env

EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
SMART_PRODUCT_PICKER=true

# Must match your public HTTPS URL (Swiggy OAuth redirect whitelist)
OAUTH_REDIRECT_URI=https://swiggy.thetarunainitiative.in/auth/callback
OAUTH_CLIENT_PORT=8083
PUBLIC_BASE_URL=https://swiggy.thetarunainitiative.in

# Bind locally; nginx terminates TLS on 443
HOST=127.0.0.1
PORT=8083

# Persist DB outside repo root (survives git pull)
DATABASE_PATH=/home/ec2-user/swiggy/data/household.db

DEBUG_PIPELINE=false
POLL_OPEN_SECONDS=90

# Optional Telegram bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-to-random-string
WHATSAPP_API_VERSION=v25.0
# Map phone digits to sender name (comma-separated phone:name)
# IMPORTANT: list EVERY family member's WhatsApp number here so they get
# notified when someone else adds to the cart. Each person must also text
# the bot at least once (Meta 24h messaging window).
WHATSAPP_PHONE_MAP=91XXXXXXXXXX:Mom,91XXXXXXXXXX:Dad

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-long-random-string
