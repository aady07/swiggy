# --- Gemini (recommended if you have a Google AI key) ---
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-key-here

GEMINI_MODEL=gemini-2.5-flash
SMART_PRODUCT_PICKER=true
# EXTRACTION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Or no LLM (simple "milk and bread" splitting only) ---
# EXTRACTION_PROVIDER=none

OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OAUTH_CLIENT_PORT=8000
DATABASE_PATH=./household.db
HOST=127.0.0.1
PORT=8000

# Optional Telegram bot
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_MAP=91XXXXXXXXXX:Mom,91XXXXXXXXXX:Dad

# Admin dashboard login (change on production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=change-me-to-random-string

# --- EC2 production (see deploy/env.production.example) ---
# OAUTH_REDIRECT_URI=https://swiggy.thetarunainitiative.in/auth/callback
# PUBLIC_BASE_URL=https://swiggy.thetarunainitiative.in
# HOST=127.0.0.1
# PORT=8083
